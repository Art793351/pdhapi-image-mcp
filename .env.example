PDHAPI_BASE_URL=https://pdhlzy.com
PDHAPI_API_KEY=
# Alternatively, point to a local UTF-8 file containing only your key.
# PDHAPI_API_KEY_FILE=/absolute/path/to/private-key.txt
PDHAPI_MODEL=gpt-image-2.5-flare
PDHAPI_EDIT_MODEL=gpt-image-2.5-sunburst
# PDHAPI_SAVE_DIR=/absolute/path/to/output
# PDHAPI_INPUT_ROOT=/absolute/path/to/reference-images
# Add exact CDN hostnames only when your image channel returns URLs.
# PDHAPI_DOWNLOAD_HOSTS=cdn.example.com
PDHAPI_TIMEOUT_SECONDS=300
